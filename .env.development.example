# ============================================================
# NUWACO WMS — Development Environment Template
# ============================================================
# Copy this file to .env.development (repo root) and fill in every value.
# DO NOT commit .env.development to git — it's already in .gitignore.
#
# Usage:
#   docker compose -f docker-compose.dev.yml --env-file .env.development up -d
#   (or: ./scripts/dev-up.sh)
#
# Generating secrets (run on the VPS):
#   openssl rand -base64 48   ->  JWT_SECRET, JWT_REFRESH_SECRET
#   openssl rand -base64 32   ->  REDIS_PASSWORD, CHIRPSTACK_API_SECRET
#   openssl rand -hex 32      ->  DB_PASSWORD, CHIRPSTACK_DB_PASSWORD
#
# This is a separate, isolated credential set from .env.production —
# do not reuse production secrets here.
# ============================================================


# ── Application ──────────────────────────────────────────────────────────────

APP_VERSION=dev
FRONTEND_URL=http://localhost:3000


# ── Database (PostgreSQL) ────────────────────────────────────────────────────

# Shared between the dev backend and dev Odoo instance.
# The dev postgres container is created with POSTGRES_USER=geedsan_dev.
DB_PASSWORD=CHANGE_ME_dev_password


# ── JWT Authentication ────────────────────────────────────────────────────────

JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME


# ── Redis ────────────────────────────────────────────────────────────────────

REDIS_PASSWORD=CHANGE_ME


# ── Odoo ERP ─────────────────────────────────────────────────────────────────

ODOO_ADMIN_PASSWORD=CHANGE_ME
ODOO_USERNAME=admin
ODOO_API_KEY=CHANGE_ME
ODOO_PASSWORD=


# ── MQTT (Mosquitto) ─────────────────────────────────────────────────────────

MQTT_USERNAME=geedsan_dev
MQTT_PASSWORD=CHANGE_ME

MQTT_CHIRPSTACK_USERNAME=chirpstack_dev
MQTT_CHIRPSTACK_PASSWORD=CHANGE_ME


# ── ChirpStack ───────────────────────────────────────────────────────────────

CHIRPSTACK_API_KEY=CHANGE_ME
CHIRPSTACK_TENANT_ID=CHANGE_ME
CHIRPSTACK_DB_PASSWORD=CHANGE_ME
CHIRPSTACK_API_SECRET=CHANGE_ME
