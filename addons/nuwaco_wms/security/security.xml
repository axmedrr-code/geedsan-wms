<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Categories -->
  <record id="module_category_nuwaco" model="ir.module.category">
    <field name="name">NUWACO WMS</field>
    <field name="sequence">30</field>
  </record>

  <!-- Groups -->
  <record id="group_wms_user" model="res.groups">
    <field name="name">User</field>
    <field name="category_id" ref="module_category_nuwaco"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_wms_manager" model="res.groups">
    <field name="name">Manager</field>
    <field name="category_id" ref="module_category_nuwaco"/>
    <field name="implied_ids" eval="[(4, ref('group_wms_user'))]"/>
    <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
  </record>

</odoo>
