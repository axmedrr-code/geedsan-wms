<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_nuwaco_alarm_list" model="ir.ui.view">
    <field name="name">nuwaco.alarm.list</field>
    <field name="model">nuwaco.alarm</field>
    <field name="arch" type="xml">
      <list string="Alarms"
            decoration-danger="severity=='critical'"
            decoration-warning="severity=='warning'">
        <field name="triggered_at"/>
        <field name="meter_id"/>
        <field name="partner_id"/>
        <field name="alarm_type"/>
        <field name="severity"/>
        <field name="status"/>
        <field name="message"/>
        <field name="resolved_at"/>
      </list>
    </field>
  </record>

  <record id="view_nuwaco_alarm_form" model="ir.ui.view">
    <field name="name">nuwaco.alarm.form</field>
    <field name="model">nuwaco.alarm</field>
    <field name="arch" type="xml">
      <form string="Alarm">
        <header>
          <field name="status" widget="statusbar" statusbar_visible="active,acknowledged,resolved"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="meter_id"/>
              <field name="partner_id"/>
              <field name="wms_alarm_id" readonly="1"/>
            </group>
            <group>
              <field name="alarm_type"/>
              <field name="severity"/>
              <field name="triggered_at"/>
              <field name="resolved_at"/>
            </group>
          </group>
          <group string="Details">
            <field name="message" nolabel="1" colspan="2"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_nuwaco_alarm_search" model="ir.ui.view">
    <field name="name">nuwaco.alarm.search</field>
    <field name="model">nuwaco.alarm</field>
    <field name="arch" type="xml">
      <search>
        <field name="meter_id"   string="Meter"/>
        <field name="partner_id" string="Customer"/>
        <field name="alarm_type" string="Alarm Type"/>
        <separator/>
        <filter name="active"   string="Active"   domain="[('status','=','active')]"/>
        <filter name="critical" string="Critical" domain="[('severity','=','critical')]"/>
        <separator/>
        <group expand="0" string="Group By">
          <filter string="Type"     name="by_type"     context="{'group_by':'alarm_type'}"/>
          <filter string="Severity" name="by_severity" context="{'group_by':'severity'}"/>
          <filter string="Meter"    name="by_meter"    context="{'group_by':'meter_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_nuwaco_alarm" model="ir.actions.act_window">
    <field name="name">Alarms</field>
    <field name="res_model">nuwaco.alarm</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_nuwaco_alarm_search"/>
    <field name="context">{'search_default_active': 1}</field>
  </record>

</odoo>
