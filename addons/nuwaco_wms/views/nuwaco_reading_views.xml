<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_nuwaco_reading_list" model="ir.ui.view">
    <field name="name">nuwaco.reading.list</field>
    <field name="model">nuwaco.reading</field>
    <field name="arch" type="xml">
      <list string="Meter Readings" create="false" edit="false">
        <field name="timestamp"/>
        <field name="meter_id"/>
        <field name="partner_id"/>
        <field name="total_consumption" string="Total (m³)"/>
        <field name="current_flow"      string="Flow (m³/h)"/>
        <field name="battery_voltage"   string="Battery (V)"/>
        <field name="rssi"/>
        <field name="source"/>
      </list>
    </field>
  </record>

  <record id="view_nuwaco_reading_form" model="ir.ui.view">
    <field name="name">nuwaco.reading.form</field>
    <field name="model">nuwaco.reading</field>
    <field name="arch" type="xml">
      <form string="Meter Reading" create="false" edit="false">
        <sheet>
          <group>
            <group>
              <field name="meter_id"/>
              <field name="partner_id"/>
              <field name="timestamp"/>
              <field name="wms_reading_id"/>
            </group>
            <group>
              <field name="total_consumption"/>
              <field name="current_flow"/>
              <field name="battery_voltage"/>
              <field name="rssi"/>
              <field name="source"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_nuwaco_reading_search" model="ir.ui.view">
    <field name="name">nuwaco.reading.search</field>
    <field name="model">nuwaco.reading</field>
    <field name="arch" type="xml">
      <search>
        <field name="meter_id"   string="Meter"/>
        <field name="partner_id" string="Customer"/>
        <filter name="today"  string="Today"  domain="[('timestamp','&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
        <group expand="0" string="Group By">
          <filter string="Meter"    name="by_meter"    context="{'group_by':'meter_id'}"/>
          <filter string="Customer" name="by_customer" context="{'group_by':'partner_id'}"/>
          <filter string="Day"      name="by_day"      context="{'group_by':'timestamp:day'}"/>
          <filter string="Source"   name="by_source"   context="{'group_by':'source'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_nuwaco_reading" model="ir.actions.act_window">
    <field name="name">Meter Readings</field>
    <field name="res_model">nuwaco.reading</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_nuwaco_reading_search"/>
  </record>

</odoo>
