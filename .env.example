# NUWACO WMS - Docker Environment Configuration
# Copy this file to .env and update values

# Database
DB_PASSWORD=geedsan-db-password-change-this-in-production

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=geedsan-jwt-secret-change-this-in-production-2024
JWT_REFRESH_SECRET=geedsan-refresh-secret-change-this-in-production-2024

# URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Public Odoo URL baked into the frontend build for the "Open in Odoo"
# button — must be browser-reachable. In production this must be the
# public Odoo subdomain (e.g. https://odoo.geedsan.com), NOT the internal
# ODOO_URL below, which stays http://odoo:8069 for backend XML-RPC only.
NEXT_PUBLIC_ODOO_URL=http://localhost:8069

# MQTT (LoRaWAN device integration) — mosquitto runs as part of this stack
MQTT_BROKER=mqtt://mosquitto:1883
MQTT_CLIENT_ID=geedsan-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPICS=application/+/device/+/event/up,application/+/device/+/event/join

# ChirpStack (runs as part of this stack — http://localhost:8080)
CHIRPSTACK_URL=http://chirpstack:8080
CHIRPSTACK_API_KEY=
CHIRPSTACK_TENANT_ID=your-tenant-id
CHIRPSTACK_API_SECRET=change-this-chirpstack-jwt-secret

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# WhatsApp (optional)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Anthropic AI (for AI features)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Odoo ERP integration (XML-RPC, in-network)
ODOO_URL=http://odoo:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_API_KEY=
ODOO_PASSWORD=your-odoo-admin-password

# Enables /api/testing/* (synthetic meter/reading injection through the real
# ingestion pipeline, for exercising billing without real hardware). Only
# ever set to 'true' on a dev/staging stack — these routes write into the
# real database, so a production deployment must leave this unset.
ENABLE_TESTING_ROUTES=true
