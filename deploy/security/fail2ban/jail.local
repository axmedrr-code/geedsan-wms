# /etc/fail2ban/jail.local — NUWACO WMS Production
#
# Installed by deploy/security/setup-security.sh.
# Changes here take effect after: sudo systemctl reload fail2ban

[DEFAULT]
# Global ban / detection settings
bantime   = 3600       # 1 hour ban
findtime  = 600        # 10-minute window for counting failures
maxretry  = 5          # failures before ban
banaction = iptables-multiport
backend   = systemd

# Email notification (optional — configure if sendmail is set up)
# destemail = admin@geedsan.com
# sender    = fail2ban@geedsan.com
# action    = %(action_mwl)s

# ── SSH protection ────────────────────────────────────────────────────────────
# Primary attack surface — SSH is exposed directly (not through Cloudflare).
[sshd]
enabled  = true
port     = ssh
logpath  = %(sshd_log)s
backend  = %(sshd_backend)s
maxretry = 3
bantime  = 86400    # 24-hour ban for SSH brute force (more aggressive than default)
findtime = 300      # 5 minutes

# ── nginx: 429 rate-limit exhaustion ─────────────────────────────────────────
# Bans IPs that trigger nginx rate limiting repeatedly.
# These are real visitor IPs (Cloudflare restoration happens in nginx before logging).
# NOTE: Since traffic comes through Cloudflare, iptables bans do NOT block the
# visitor at the network level. This jail primarily serves as an audit log.
# To block at the CF edge, configure the cloudflare action (see below).
[nginx-limit-req]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/api.access.log
           /var/log/nginx/wms.access.log
filter   = nginx-limit-req
maxretry = 20       # Allow bursts; ban after sustained rate-limit hits
bantime  = 1800     # 30-minute ban
findtime = 60

# ── nginx: 4xx scanner detection ──────────────────────────────────────────────
# Bans IPs that generate many 404/403 errors (path scanners, exploit bots).
[nginx-botscan]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/wms.access.log
           /var/log/nginx/api.access.log
filter   = nginx-botsearch
maxretry = 15
bantime  = 3600
findtime = 120

# ── nginx: repeated auth failures ─────────────────────────────────────────────
[nginx-auth-fail]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/api.access.log
filter   = nginx-auth-fail
maxretry = 10
bantime  = 3600
findtime = 300
