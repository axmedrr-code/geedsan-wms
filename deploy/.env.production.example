# ============================================================
# NUWACO WMS — Production Environment Template
# ============================================================
# Copy this file to .env.production and fill in every value.
# DO NOT commit .env.production to git.
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Generating secrets (run on the server):
#   openssl rand -base64 48   →  use for JWT_SECRET, JWT_REFRESH_SECRET
#   openssl rand -base64 32   →  use for REDIS_PASSWORD, CHIRPSTACK_API_SECRET
#   openssl rand -hex 32      →  use for DB_PASSWORD, CHIRPSTACK_DB_PASSWORD
# ============================================================


# ── Application ──────────────────────────────────────────────────────────────

# Optional image tag; defaults to "latest"
APP_VERSION=1.0.0

# Public URL of the WMS frontend — used by the backend for CORS allowed origins
FRONTEND_URL=https://wms.geedsan.com

# Public URL of the backend API — baked into the Next.js frontend at build time
# so the browser knows where to send all /api/* requests.
API_URL=https://api.geedsan.com

# Public URL of Odoo — baked into the Next.js frontend at build time so the
# "Open in Odoo" button links somewhere the user's browser can actually
# reach. Must be the public subdomain (matches deploy/nginx/conf.d/odoo.conf
# server_name), NOT the internal http://odoo:8069 Docker hostname used by
# the backend's own XML-RPC sync — that one stays internal on purpose.
ODOO_PUBLIC_URL=https://odoo.geedsan.com

# Optional. Controls what geedsan.com / www.geedsan.com serve (see
# deploy/nginx/start.sh). Leave unset/blank to serve the static landing
# page in deploy/nginx/landing/. Set to a hostname (no scheme) to 302
# (temporary) redirect the apex/www there instead, e.g.:
#   WEBSITE_TARGET=wms.geedsan.com
WEBSITE_TARGET=


# ── Database (PostgreSQL) ────────────────────────────────────────────────────

# Shared between WMS backend and Odoo.
# The postgres container is created with POSTGRES_USER=geedsan.
DB_PASSWORD=CHANGE_ME_strong_random_password


# ── JWT Authentication ────────────────────────────────────────────────────────

# openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME


# ── Redis ────────────────────────────────────────────────────────────────────

# openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME


# ── Odoo ERP ─────────────────────────────────────────────────────────────────

# The Odoo admin (master) password — set once during Odoo first-run setup
ODOO_ADMIN_PASSWORD=CHANGE_ME

# Odoo user account used by the WMS backend for XML-RPC sync
ODOO_USERNAME=admin

# Must be a real API key generated under the SAME Odoo user named by
# ODOO_USERNAME above — a valid key paired with the wrong username fails
# authentication the same way an invalid key does. Odoo 18: log in as that
# user -> avatar (top right) -> My Profile -> Account Security tab -> New
# API Key. Odoo shows the key once; copy it here immediately.
# Fallback: leave blank and set ODOO_PASSWORD instead (less secure).
ODOO_API_KEY=CHANGE_ME

# Only needed if ODOO_API_KEY is blank
ODOO_PASSWORD=


# ── MQTT (Mosquitto) ─────────────────────────────────────────────────────────

# Credentials for the WMS backend service
# Add to mosquitto passwd file: mosquitto_passwd /path/to/passwd <username>
MQTT_USERNAME=geedsan
MQTT_PASSWORD=CHANGE_ME

# Credentials for the ChirpStack service (separate mosquitto account)
MQTT_CHIRPSTACK_USERNAME=chirpstack
MQTT_CHIRPSTACK_PASSWORD=CHANGE_ME

# Comma-separated MQTT topic subscription pattern
MQTT_TOPICS=application/#


# ── ChirpStack ───────────────────────────────────────────────────────────────

# ChirpStack API key (generated in ChirpStack UI after first boot)
CHIRPSTACK_API_KEY=CHANGE_ME

# ChirpStack tenant ID (found in ChirpStack UI ▸ Tenants)
CHIRPSTACK_TENANT_ID=CHANGE_ME

# PostgreSQL password for the chirpstack database user
# Must match the password used when creating the chirpstack DB user:
#   CREATE USER chirpstack WITH PASSWORD '...';
CHIRPSTACK_DB_PASSWORD=CHANGE_ME

# JWT secret for ChirpStack internal API — openssl rand -base64 32
CHIRPSTACK_API_SECRET=CHANGE_ME


# ── Email (SMTP) ─────────────────────────────────────────────────────────────

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notifications@example.com
EMAIL_PASS=CHANGE_ME


# ── Telegram Alerts ──────────────────────────────────────────────────────────

# Create a bot via @BotFather to get the token.
# To get your chat ID: message @userinfobot on Telegram, or send a message
# to the bot then call: curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME


# ── Monitoring (Phase 8) ──────────────────────────────────────────────────────

# Grafana admin password — access via SSH tunnel (ssh -L 3001:localhost:3001 user@server)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password

# Optional: S3-compatible bucket for off-site backup sync (Phase 7)
# Configure rclone remote named "nuwaco-s3" on the server first: sudo rclone config
BACKUP_S3_BUCKET=
