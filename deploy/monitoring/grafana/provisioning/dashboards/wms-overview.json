{
  "title": "NUWACO WMS — Overview",
  "uid": "nuwaco-wms-overview",
  "tags": ["nuwaco", "wms", "production"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-3h", "to": "now" },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [

    {
      "id": 1, "type": "row", "collapsed": false,
      "title": "🟢 Service Health",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },

    {
      "id": 2, "type": "stat",
      "title": "WMS Frontend",
      "description": "wms.geedsan.com",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "options": {
        "colorMode": "background", "graphMode": "none",
        "justifyMode": "center", "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN",  "color": "red"   }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "probe_success{job=\"blackbox_http\", instance=\"https://wms.geedsan.com\"}",
        "legendFormat": "", "instant": true
      }]
    },

    {
      "id": 3, "type": "stat",
      "title": "Backend API",
      "description": "api.geedsan.com/health",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "options": {
        "colorMode": "background", "graphMode": "none",
        "justifyMode": "center", "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "probe_success{job=\"blackbox_http\", instance=\"https://api.geedsan.com/health\"}",
        "legendFormat": "", "instant": true
      }]
    },

    {
      "id": 4, "type": "stat",
      "title": "Odoo ERP",
      "description": "odoo.geedsan.com",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "options": {
        "colorMode": "background", "graphMode": "none",
        "justifyMode": "center", "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "probe_success{job=\"blackbox_http\", instance=\"https://odoo.geedsan.com/web/login\"}",
        "legendFormat": "", "instant": true
      }]
    },

    {
      "id": 5, "type": "stat",
      "title": "ChirpStack / MQTT",
      "description": "lns.geedsan.com + MQTT:1883",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "options": {
        "colorMode": "background", "graphMode": "none",
        "justifyMode": "center", "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "min(probe_success{job=~\"blackbox_http|blackbox_tcp\", instance=~\"https://lns.geedsan.com|mosquitto:1883\"})",
        "legendFormat": "", "instant": true
      }]
    },

    {
      "id": 6, "type": "table",
      "title": "Endpoint Response Times & SSL Expiry",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 7 },
      "options": { "footer": { "show": false }, "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "displayMode": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" },
            "properties": [{ "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [{ "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }] }]
          },
          { "matcher": { "id": "byName", "options": "Response Time" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }]
          },
          { "matcher": { "id": "byName", "options": "SSL Expiry (days)" },
            "properties": [{ "id": "decimals", "value": 0 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 7 }, { "color": "yellow", "value": 30 }, { "color": "green", "value": 60 }] } },
              { "id": "custom.displayMode", "value": "color-text" }]
          }
        ]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "renameByName": { "instance": "Endpoint", "Value #A": "Status", "Value #B": "Response Time", "Value #C": "SSL Expiry (days)" } } }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_success{job=\"blackbox_http\"}",
          "legendFormat": "{{instance}}", "instant": true, "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_duration_seconds{job=\"blackbox_http\"}",
          "legendFormat": "{{instance}}", "instant": true, "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox_http\"} - time()) / 86400",
          "legendFormat": "{{instance}}", "instant": true, "refId": "C"
        }
      ]
    },

    {
      "id": 10, "type": "row", "collapsed": false,
      "title": "🖥 Host Resources",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 1 }
    },

    {
      "id": 11, "type": "timeseries",
      "title": "CPU Usage %",
      "gridPos": { "x": 0, "y": 13, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "CPU {{ instance }}"
      }]
    },

    {
      "id": 12, "type": "timeseries",
      "title": "Memory Usage %",
      "gridPos": { "x": 8, "y": 13, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
          "legendFormat": "Used %"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_Cached_bytes / node_memory_MemTotal_bytes * 100",
          "legendFormat": "Cached %"
        }
      ]
    },

    {
      "id": 13, "type": "gauge",
      "title": "Disk Usage — /",
      "gridPos": { "x": 16, "y": 13, "w": 8, "h": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "(node_filesystem_size_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} - node_filesystem_avail_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"}) / node_filesystem_size_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} * 100",
        "legendFormat": "/ (root)", "instant": true
      }]
    },

    {
      "id": 20, "type": "row", "collapsed": false,
      "title": "🐳 Container Metrics",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 }
    },

    {
      "id": 21, "type": "timeseries",
      "title": "Container CPU Usage %",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"geedsan\", image!=\"\"}[5m])) * 100",
        "legendFormat": "{{ container_label_com_docker_compose_service }}"
      }]
    },

    {
      "id": 22, "type": "timeseries",
      "title": "Container Memory (RSS)",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "container_memory_rss{container_label_com_docker_compose_project=\"geedsan\", image!=\"\"}",
        "legendFormat": "{{ container_label_com_docker_compose_service }}"
      }]
    },

    {
      "id": 30, "type": "row", "collapsed": false,
      "title": "🗄 PostgreSQL",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 }
    },

    {
      "id": 31, "type": "timeseries",
      "title": "DB Active Connections",
      "gridPos": { "x": 0, "y": 31, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_stat_activity_count{datname=\"geedsan_wms\"}",
          "legendFormat": "geedsan_wms"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_stat_activity_count{datname=\"odoo\"}",
          "legendFormat": "odoo"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_settings_max_connections",
          "legendFormat": "max_connections"
        }
      ]
    },

    {
      "id": 32, "type": "timeseries",
      "title": "DB Transactions / sec",
      "gridPos": { "x": 8, "y": 31, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(pg_stat_database_xact_commit{datname=\"geedsan_wms\"}[5m])",
          "legendFormat": "commits/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"geedsan_wms\"}[5m])",
          "legendFormat": "rollbacks/s"
        }
      ]
    },

    {
      "id": 33, "type": "stat",
      "title": "Deadlocks (last hour)",
      "gridPos": { "x": 16, "y": 31, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["sum"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "increase(pg_stat_database_deadlocks{datname=~\"geedsan_wms|odoo\"}[1h])",
        "legendFormat": "{{ datname }}", "instant": true
      }]
    },

    {
      "id": 34, "type": "stat",
      "title": "Cache Hit Ratio",
      "gridPos": { "x": 20, "y": 31, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.90 }, { "color": "green", "value": 0.95 }] }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "pg_stat_database_blks_hit{datname=\"geedsan_wms\"} / (pg_stat_database_blks_hit{datname=\"geedsan_wms\"} + pg_stat_database_blks_read{datname=\"geedsan_wms\"} + 1)",
        "legendFormat": "Cache Hit", "instant": true
      }]
    },

    {
      "id": 40, "type": "row", "collapsed": false,
      "title": "⚡ Redis",
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 1 }
    },

    {
      "id": 41, "type": "timeseries",
      "title": "Redis Connected Clients & Ops/sec",
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "redis_connected_clients",
          "legendFormat": "Connected Clients"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(redis_commands_processed_total[5m])",
          "legendFormat": "Commands/sec"
        }
      ]
    },

    {
      "id": 42, "type": "timeseries",
      "title": "Redis Memory Usage",
      "gridPos": { "x": 12, "y": 40, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Used"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "redis_memory_max_bytes",
          "legendFormat": "Max (limit)"
        }
      ]
    },

    {
      "id": 43, "type": "stat",
      "title": "Redis Keyspace Hit Rate",
      "gridPos": { "x": 20, "y": 40, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.9 }] }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total + 1)",
        "legendFormat": "Hit Rate", "instant": true
      }]
    },

    {
      "id": 50, "type": "row", "collapsed": false,
      "title": "🔒 SSL & Network",
      "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 }
    },

    {
      "id": 51, "type": "gauge",
      "title": "SSL Certificate Expiry (days)",
      "gridPos": { "x": 0, "y": 49, "w": 12, "h": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": true }, "orientation": "auto", "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0, "max": 90,
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 7 }, { "color": "yellow", "value": 30 }, { "color": "green", "value": 60 }] }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox_http\"} - time()) / 86400",
        "legendFormat": "{{ instance }}", "instant": true
      }]
    },

    {
      "id": 52, "type": "timeseries",
      "title": "Network I/O (host)",
      "gridPos": { "x": 12, "y": 49, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_network_receive_bytes_total{device=~\"eth0|ens.*\"}[5m])",
          "legendFormat": "RX {{ device }}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_network_transmit_bytes_total{device=~\"eth0|ens.*\"}[5m])",
          "legendFormat": "TX {{ device }}"
        }
      ]
    },

    {
      "id": 60, "type": "row", "collapsed": false,
      "title": "🔔 Active Alerts",
      "gridPos": { "x": 0, "y": 57, "w": 24, "h": 1 }
    },

    {
      "id": 61, "type": "table",
      "title": "Firing Alerts",
      "gridPos": { "x": 0, "y": 58, "w": 24, "h": 8 },
      "options": { "footer": { "show": false }, "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "Severity", "desc": false }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "displayMode": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "severity" },
            "properties": [{ "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "critical": { "color": "red",    "text": "CRITICAL" } } },
                { "type": "value", "options": { "warning":  { "color": "yellow", "text": "WARNING"  } } }
              ]}
            ]
          }
        ]
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "ALERTS{alertstate=\"firing\"}",
        "legendFormat": "{{ alertname }}", "instant": true
      }]
    }

  ]
}
